AUDIO_ANALYSIS_BASIC_AUTH_USERNAME=analysis
AUDIO_ANALYSIS_BASIC_AUTH_PASSWORD=
# Required startup value. The exact PAX R2 host is allowed in code.
AUDIO_ANALYSIS_ALLOWED_HOSTS=pax-r2-not-provisioned.invalid
AUDIO_ANALYSIS_MAX_DOWNLOAD_BYTES=157286400
AUDIO_ANALYSIS_DOWNLOAD_TIMEOUT_SECONDS=90
AUDIO_ANALYSIS_CONCURRENCY=2
AUDIO_ANALYSIS_DEADLINE_SECONDS=100
AUDIO_ANALYSIS_QUEUE_LIMIT=4
AUDIO_ANALYSIS_QUEUE_WAIT_SECONDS=20
AUDIO_ANALYSIS_MAX_DURATION_SECONDS=300
# Optional. Defaults to the system temp dir.
# AUDIO_ANALYSIS_DATA_DIR=
